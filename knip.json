{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/**/*.mjs"],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "dev/**/*.ts"],
  "ignoreDependencies": [
    "tailwindcss",
    "@fontsource-variable/inter",
    "@fontsource-variable/inter-tight",
    "@fontsource-variable/source-sans-3",
    "lint-staged"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "exports": "error",
    "types": "error",
    "duplicates": "error"
  }
}
