# Local-dev only. Deployed builds derive the API origin from the browser host
# (see src/config/env.ts) — do not bake per-environment values.
#
# Default: same-origin mock API (no kitchenxhire-backend-go required). Vite serves
# handlers from dev/mockApi.ts when this path is used.
VITE_API_BASE_URL=/api/v1
#
# Optional: point at a running backend instead (mock plugin stays off):
# VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1
