{
  "name": "kitchenxhire-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_API_BASE_URL=/api/v1 vite --mode mock",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "guard:contracts": "node scripts/guards/check-page-contracts.mjs",
    "guard:stale": "node scripts/guards/check-stale-markers.mjs",
    "guard:skills": "node scripts/guards/check-agent-skills.mjs",
    "guard": "npm run guard:contracts && npm run guard:stale && npm run guard:skills",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run guard && npm run knip && npm run test",
    "new:module": "node scripts/new-module.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.21.0",
    "buffer": "6.0.3",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "lucide-react": "1.59.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.90.0",
    "react-router": "8.3.0",
    "recharts": "2.15.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
